# Copy this file to .env and fill in the token locally. Never commit .env.
PADDLEOCR_ACCESS_TOKEN=
# Optional official-compatible endpoint override.
PADDLEOCR_BASE_URL=
PADDLEOCR_REQUEST_TIMEOUT=300
PADDLEOCR_POLL_TIMEOUT=900

# Change these before exposing the service outside localhost.
BENCAO_SECRET_KEY=replace-with-a-long-random-secret
BENCAO_CORS_ORIGINS=http://127.0.0.1:30080,http://localhost:30080

# Optional site-wide test-mode credentials (used by OCR and semantic models
# when an admin enables test mode in system settings). Leave empty otherwise.
BENCAO_TEST_OCR_BASE_URL=
BENCAO_TEST_OCR_TOKEN=
BENCAO_TEST_OCR_MODEL=
BENCAO_TEST_SEMANTIC_BASE_URL=
BENCAO_TEST_SEMANTIC_API_KEY=
BENCAO_TEST_SEMANTIC_MODEL=
